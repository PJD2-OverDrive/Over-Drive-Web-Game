{
  "name": "over-drive-web-game",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "shared",
    "server"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter @overdrive/client --filter @overdrive/server dev",
